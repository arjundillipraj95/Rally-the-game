{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh setup", "timeout": 180 } ] },
      { "matcher": "compact", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh compact", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Grep", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh search", "timeout": 10 } ] },
      { "matcher": "Read|Glob", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh read", "timeout": 10 } ] }
    ]
  }
}
